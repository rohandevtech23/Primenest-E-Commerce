# PostgreSQL Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=primenest_db
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# Admin Authentication & JWT
ADMIN_SESSION_SECRET=primenest_super_secret_jwt_key_minimum_32_characters_long_12345
ADMIN_EMAIL=admin@primenest.com
# Default bcrypt hash for 'admin123'
# Optional AI Features (Google Gemini / Virtual Try-On)
# Get free Gemini key at: https://aistudio.google.com/
GEMINI_API_KEY=
# Optional: Replicate API token for IDM-VTON cloud try-on
REPLICATE_API_TOKEN=
